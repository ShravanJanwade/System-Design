{
  "name": "blueprint",
  "private": true,
  "version": "0.1.0",
  "description": "Blueprint: a system design learning app, from first request to FAANG-level interviews.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:content": "tsx --tsconfig tsconfig.app.json scripts/check-content.ts",
    "typecheck": "tsc -b",
    "build": "npm run manifest && npm run search-index && npm run check:content && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "metrics": "node scripts/generate-font-metrics.mjs",
    "manifest": "tsx --tsconfig tsconfig.app.json scripts/generate-manifest.ts",
    "search-index": "tsx --tsconfig tsconfig.app.json scripts/generate-search-index.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "cmdk": "1.1.1",
    "lucide-react": "1.74.0",
    "minisearch": "7.2.0",
    "motion": "14.14.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "opentype.js": "2.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
